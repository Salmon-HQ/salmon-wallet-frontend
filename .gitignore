# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/


# Turborepo
.turbo/

# Lighthouse CI run data (reports go to the gitignored suite reports/ dir)
.lighthouseci/
**/.lighthouseci/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
credentials.json

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env
.env.prod
.env.production
.env.staging

# typescript
*.tsbuildinfo

# testing
coverage/

# generated native folders
ios/
android/

# build artifacts
*.apk
*.aab
*.ipa

# Per-app Playwright test suites — track scripts + docs, ignore runtime + secrets
apps/*/.playwright/.env.test
apps/*/.playwright/profiles/
apps/*/.playwright/screenshots/
apps/*/.playwright/snapshots/
apps/*/.playwright/reports/
apps/*/.playwright/fixtures/
apps/*/.playwright/test-results/
apps/*/.playwright/playwright-report/

# `playwright-cli` skill auto-generated artifacts (per-cwd, unrelated to per-app suites above)
.playwright-cli/
**/.playwright-cli/

# Per-app Maestro suites — track flows + docs, ignore runtime + secrets
apps/*/.maestro/.env.test
apps/*/.maestro/screenshots/
apps/*/.maestro/snapshots/
apps/*/.maestro/reports/

# Maestro debug logs record every inputText character, so a run transcript
# contains the test seed phrase in the clear. Never let one get committed.
maestro.log
**/maestro.log

# Defensive: stray top-level .maestro/ directories created when Maestro
# is invoked from the wrong cwd (takeScreenshot paths are cwd-relative).
/.maestro/
**/.maestro/screenshots/

# Agent worktrees — live checkouts must never be captured as gitlinks
.claude/worktrees/

# Private agent memory — never commit
AGENTS.local.md
CLAUDE.local.md
**/AGENTS.local.md
**/CLAUDE.local.md
.claude/settings.local.json
# Local-only security map (documents known wallet security gaps — must not be
# published to this public repo). Kept local like AGENTS.local.md.
.claude/skills/security-context/
.code-review-graph/

# Local planning notes — not part of the repo contract
docs/plans/
docs/app-store/
docs/research/

# Generated AMO source archive (pnpm pack:sources)
salmon-wallet-source.zip
