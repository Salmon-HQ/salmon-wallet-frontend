{
  "name": "@salmon/extension",
  "version": "0.13.1",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "private": true,
  "scripts": {
    "postinstall": "node -e \"try{require.resolve('wxt')}catch{process.exit(0)};require('child_process').execSync('wxt prepare',{stdio:'inherit'})\"",
    "dev": "wxt",
    "build": "wxt build",
    "build:staging": "wxt build --mode staging",
    "build:prod": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:firefox:staging": "wxt build -b firefox --mode staging",
    "build:firefox:prod": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "node --no-warnings ../../node_modules/vitest/vitest.mjs run --passWithNoTests",
    "test:watch": "node --no-warnings ../../node_modules/vitest/vitest.mjs",
    "test:coverage": "node --no-warnings ../../node_modules/vitest/vitest.mjs run --coverage",
    "e2e": "playwright test -c .playwright/playwright.config.ts",
    "e2e:ui": "playwright test -c .playwright/playwright.config.ts --ui"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@salmon/shared": "workspace:*",
    "@salmon/ui": "workspace:*",
    "@solana/kit": "^7.0.0",
    "@solana/wallet-standard-features": "^1.4.0",
    "@wallet-standard/base": "^1.1.1",
    "@wallet-standard/features": "^1.1.1",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "eventemitter3": "^5.0.1",
    "i18next": "^25.6.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "process": "^0.11.10",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "^16.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@solana/web3.js": "^1.98.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/chrome": "^0.2.5",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "^27.4.0",
    "typescript": "~5.9.2",
    "vite": "^7.3.1",
    "vitest": "^4.1.10",
    "wxt": "^0.21.3"
  }
}
