{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    // wxt 0.21 turned these on in its generated tsconfig; the workspace
    // (shared/ui sources type-checked through our paths) is not ready for
    // them yet. Revisit as a deliberate strictness migration.
    "verbatimModuleSyntax": false,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": false,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets": ["./src/assets"],
      "@salmon/shared": ["../../packages/shared/src"],
      "@salmon/shared/*": ["../../packages/shared/src/*"],
      "@salmon/ui": ["../../packages/ui/src"],
      "@salmon/ui/*": ["../../packages/ui/src/*"]
    }
  }
}
