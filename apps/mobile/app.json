{
  "expo": {
    "name": "Salmon Wallet",
    "slug": "salmon-wallet",
    "owner": "salmon-wallet",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/ios-icon.png",
    "scheme": "salmonwallet",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#10131c",
    "androidStatusBar": {
      "barStyle": "light-content"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "io.salmonwallet.app",
      "backgroundColor": "#10131c",
      "icon": {
        "light": "./assets/images/ios-icon.png",
        "dark": "./assets/images/ios-icon-dark.png",
        "tinted": "./assets/images/ios-icon-tinted.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "io.salmonwallet.app",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundImage": "./assets/images/adaptive-icon-bg.png",
        "monochromeImage": "./assets/images/monochrome-icon.png",
        "backgroundColor": "#FF6F5B"
      },
      "backgroundColor": "#10131c",
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Salmon Wallet uses the camera to scan QR codes for wallet addresses and payment requests.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-dev-client",
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Salmon Wallet uses Face ID to unlock your wallet and authorize transactions."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Salmon Wallet uses Face ID to unlock your wallet and authorize transactions."
        }
      ],
      "expo-font",
      "expo-localization",
      "expo-web-browser",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#10131c",
          "image": "./assets/images/splash-blank.png",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4f3b188a-9144-4b0c-ae3d-9df7badd881d"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4f3b188a-9144-4b0c-ae3d-9df7badd881d"
    }
  }
}
