{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "24.21.0",
      "pnpm": "10.34.5"
    },
    "local": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_SALMON_ENV": "local",
        "EXPO_PUBLIC_POWERUPS": "on"
      },
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      }
    },
    "staging": {
      "extends": "base",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_SALMON_ENV": "staging",
        "EXPO_PUBLIC_POWERUPS": "on"
      },
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "staging"
    },
    "testflight": {
      "extends": "staging",
      "distribution": "store",
      "autoIncrement": true
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "env": {
        "NODE_ENV": "production",
        "EXPO_NO_DOCTOR": "1",
        "EXPO_DOCTOR_SKIP_DEPENDENCY_VERSION_CHECK": "1",
        "EXPO_PUBLIC_POWERUPS": "on"
      },
      "channel": "production"
    },
    "production-apk": {
      "extends": "production",
      "android": {
        "buildType": "apk"
      }
    },
    "dapp-store": {
      "extends": "production",
      "android": {
        "buildType": "apk",
        "credentialsSource": "remote",
        "keystoreName": "dapp-store"
      }
    },
    "dapp-store-test": {
      "extends": "dapp-store",
      "channel": "dapp-store-test",
      "autoIncrement": false
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal"
      },
      "ios": {
        "ascAppId": "6799740991",
        "appleTeamId": "ZZ8JBL35LM"
      }
    }
  }
}
