{
  "name": "@salmon/mobile",
  "main": "./index.js",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app hooks src --ext .ts,.tsx --ignore-pattern '**/*.js' --max-warnings 0",
    "test": "node --no-warnings ../../node_modules/jest/bin/jest.js --passWithNoTests",
    "test:watch": "node --no-warnings ../../node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --no-warnings ../../node_modules/jest/bin/jest.js --coverage",
    "build:aab": "f=\"salmon-wallet-$(node -p \"require('./app.json').expo.version\")-$(date +%Y-%m-%d).aab\" && eas build --platform android --profile production --local --output \"$f\"",
    "build:apk": "f=\"salmon-wallet-$(node -p \"require('./app.json').expo.version\")-$(date +%Y-%m-%d).apk\" && eas build --platform android --profile production-apk --local --output \"$f\"",
    "build:dapp-store": "f=\"salmon-wallet-$(node -p \"require('./app.json').expo.version\")-$(date +%Y-%m-%d)-dapp-store.apk\" && eas build --platform android --profile dapp-store --local --output \"$f\"",
    "build:dapp-store:remote": "eas build --platform android --profile dapp-store",
    "eas-build-post-install": "test \"$EAS_BUILD_PLATFORM\" = \"android\" && printf '\\norg.gradle.jvmargs=-Xmx4g -XX:MaxMetaspaceSize=1g\\n' >> ./android/gradle.properties || true",
    "fingerprint:check": "node scripts/check-native-fingerprint.mjs",
    "fingerprint:write": "node scripts/check-native-fingerprint.mjs --write",
    "export:check": "expo export --platform ios --output-dir /tmp/salmon-export-check",
    "ota": "node scripts/check-native-fingerprint.mjs && eas update"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-fast-crypto"
        ]
      }
    }
  },
  "dependencies": {
    "@expo/dom-webview": "58.0.2",
    "@expo/metro-runtime": "58.0.17",
    "@expo/vector-icons": "^15.0.3",
    "@noble/hashes": "^1.8.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@salmon/assets": "workspace:*",
    "@salmon/shared": "workspace:*",
    "@solana-mobile/mobile-wallet-adapter-walletlib": "1.4.5",
    "@solana-mobile/seed-vault-lib": "0.4.1",
    "@solana/webcrypto-ed25519-polyfill": "^8.4.0",
    "buffer": "^6.0.3",
    "expo": "^58.0.23",
    "expo-blur": "~58.0.6",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "^58.0.19",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "^58.0.8",
    "expo-image": "^58.0.18",
    "expo-linear-gradient": "^58.0.4",
    "expo-linking": "~58.0.17",
    "expo-local-authentication": "~58.0.3",
    "expo-localization": "^58.0.5",
    "expo-router": "~58.0.31",
    "expo-screen-capture": "~58.0.6",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "^58.0.7",
    "expo-updates": "~58.0.22",
    "expo-web-browser": "~58.0.8",
    "i18next": "^25.10.10",
    "phosphor-react-native": "^3.0.6",
    "react": "19.3.0",
    "react-content-loader": "^7.1.1",
    "react-dom": "19.3.0",
    "react-i18next": "^16.6.6",
    "react-native": "0.88.1",
    "react-native-fast-crypto": "^3.0.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-qrcode-svg": "^6.3.24",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "readable-stream": "^4.5.2"
  },
  "devDependencies": {
    "@expo/fingerprint": "0.21.10",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "typescript": "~5.9.2"
  }
}
