{
  "name": "@salmon/mobile",
  "main": "./index.js",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app hooks src --ext .ts,.tsx --ignore-pattern '**/*.js' --max-warnings 0",
    "test": "node --no-warnings ../../node_modules/jest/bin/jest.js --passWithNoTests",
    "test:watch": "node --no-warnings ../../node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --no-warnings ../../node_modules/jest/bin/jest.js --coverage",
    "build:aab": "f=\"salmon-wallet-$(node -p \"require('./app.json').expo.version\")-$(date +%Y-%m-%d).aab\" && eas build --platform android --profile production --local --output \"$f\"",
    "build:apk": "f=\"salmon-wallet-$(node -p \"require('./app.json').expo.version\")-$(date +%Y-%m-%d).apk\" && eas build --platform android --profile production-apk --local --output \"$f\"",
    "eas-build-post-install": "test \"$EAS_BUILD_PLATFORM\" = \"android\" && echo 'org.gradle.jvmargs=-Xmx4g -XX:MaxMetaspaceSize=1g' >> ./android/gradle.properties || true",
    "fingerprint:check": "node scripts/check-native-fingerprint.mjs",
    "fingerprint:write": "node scripts/check-native-fingerprint.mjs --write",
    "export:check": "expo export --platform ios --output-dir /tmp/salmon-export-check",
    "ota": "node scripts/check-native-fingerprint.mjs && eas update"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-fast-crypto"
        ]
      }
    }
  },
  "dependencies": {
    "@expo/dom-webview": "56.0.6",
    "@expo/metro-runtime": "56.0.21",
    "@expo/vector-icons": "^15.0.3",
    "@noble/hashes": "^1.8.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@salmon/assets": "workspace:*",
    "@salmon/shared": "workspace:*",
    "@solana/webcrypto-ed25519-polyfill": "^8.3.0",
    "buffer": "^6.0.3",
    "expo": "^56.0.0",
    "expo-blur": "~56.0.4",
    "expo-camera": "~56.0.8",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.26",
    "expo-crypto": "~56.0.5",
    "expo-dev-client": "^56.0.27",
    "expo-font": "~56.0.7",
    "expo-glass-effect": "~56.0.4",
    "expo-haptics": "^56.0.3",
    "expo-image": "^56.0.13",
    "expo-linear-gradient": "^56.0.4",
    "expo-linking": "~56.0.18",
    "expo-local-authentication": "~56.0.5",
    "expo-localization": "^56.0.6",
    "expo-router": "~56.2.21",
    "expo-screen-capture": "~56.0.5",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.15",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "^56.0.5",
    "expo-updates": "~56.0.27",
    "expo-web-browser": "~56.0.6",
    "i18next": "^25.10.10",
    "phosphor-react-native": "^3.0.6",
    "react": "19.2.3",
    "react-content-loader": "^7.1.1",
    "react-dom": "19.2.3",
    "react-i18next": "^16.6.6",
    "react-native": "0.85.3",
    "react-native-fast-crypto": "^3.0.0",
    "react-native-gesture-handler": "~2.31.2",
    "react-native-get-random-values": "^1.11.0",
    "react-native-qrcode-svg": "^6.3.24",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.8.3",
    "readable-stream": "^4.5.2"
  },
  "devDependencies": {
    "@expo/fingerprint": "0.19.10",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.18",
    "jest": "~29.7.0",
    "jest-expo": "~56.0.5",
    "typescript": "~5.9.2"
  }
}
