{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Global types are named, not picked up from every @types package: that
    // implicit inclusion is gone from TypeScript 6 on.
    "types": ["jest", "node"],
    "paths": {
      "@/*": ["./*"],
      "@salmon/shared": ["../../packages/shared/src"],
      "@salmon/shared/powerups": ["../../packages/shared/src/powerups"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "declarations.d.ts"]
}
