{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.{mjs,cjs}", "store-assets/**/*.mjs"]
    },
    "apps/extension": {
      "entry": [
        "src/entrypoints/**/*.{ts,tsx,html}",
        ".playwright/**/*.{ts,mjs}",
        "src/stubs/*.ts",
        "src/polyfills/*.ts",
        "src/buffer-shim.js"
      ],
      "project": ["src/**/*.{ts,tsx}", ".playwright/**/*.{ts,mjs}"]
    },
    "apps/mobile": {
      "entry": [
        "app/**/*.{ts,tsx}",
        "plugins/*.js",
        "scripts/*.mjs",
        "src/powerups/index.off.ts",
        "**/*.native.{ts,tsx}"
      ],
      "project": [
        "app/**/*.{ts,tsx}",
        "src/**/*.{ts,tsx}",
        "hooks/**/*.{ts,tsx}",
        "utils/**/*.{ts,tsx}"
      ],
      "ignoreBinaries": ["eas"],
      "ignoreDependencies": ["buffer"]
    },
    "packages/shared": {
      "entry": [
        "src/powerups/index.off.ts",
        "scripts/*.mjs",
        "src/**/*.native.{ts,tsx}",
        "src/blockchain/ethereum/**/*.ts"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["react-native", "react-native-fast-crypto"]
    },
    "packages/ui": {
      "entry": ["src/powerups.ts", "src/powerups.off.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/assets": {
      "ignoreDependencies": ["react-native-svg"]
    }
  },
  "ignoreIssues": {
    "apps/mobile/src/analytics/appAnalytics.ts": ["exports"],
    "apps/mobile/src/components/ReceiptScreen/TransferReceipt.tsx": ["exports"]
  }
}
