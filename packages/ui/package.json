    "typescript": "~5.9.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "i18next": ">=23.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-i18next": ">=15.0.0"
